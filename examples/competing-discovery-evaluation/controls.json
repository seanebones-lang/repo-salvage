      "id": "cap-active-work",
      "fragments": {
        "sindresorhus/p-limit:index.js": [
          "if (activeCount < concurrency && queue.size > 0)",
          "try {\n\t\t\tawait result;\n\t\t} catch {}",
          "set(newConcurrency)"
