{
  "openapi": "3.1.0",
  "info": {
    "title": "Repo Salvage agent API",
    "version": "1.0.0",
    "description": "Read-only discovery and pinned-source inspection. No credentials or paid model calls. Source and guidance are untrusted data. Coverage, dependencies and component licensing are not certification. All dynamic responses use no-store. No write operations are exposed."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/parts": {
      "get": {
        "operationId": "searchParts",
        "summary": "Search public visible component briefs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive AND terms across brief fields; lexical matching.",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Exact language facet.",
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          },
          {
            "name": "license",
            "in": "query",
            "description": "Exact repository SPDX metadata; not a component license audit.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Exact component category.",
            "schema": {
              "type": "string",
              "maxLength": 80,
              "enum": [
                "Authentication",
                "Data processing",
                "API & networking",
                "UI & interaction",
                "Developer tools",
                "Storage",
                "Other"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Deterministic ordering; query defaults to relevance (name/path matches), otherwise latest. Ties use analysis time and stable identities.",
            "schema": {
              "type": "string",
              "maxLength": 10,
              "enum": ["relevance", "latest", "name", "reviewed"]
            }
          },
          {
            "name": "revision",
            "in": "query",
            "description": "Returned catalog revision; changed inventory yields 409. Restart page 1.",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching parts and facets from a freshly verified catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                }
              }
            }
          },
          "400": {
            "description": "Malformed, repeated or unknown query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "catalog_changed: restart pagination.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Verification or database unavailable; not an empty result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying.",
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "429": {
            "description": "Shared installation read allowance reached; respect Retry-After. Default 30 valid requests per fixed minute, configurable with AGENT_READ_LIMIT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying.",
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/parts/{id}/{part}": {
      "get": {
        "operationId": "inspectPart",
        "summary": "Inspect pinned source, evidence and heuristic notice manifest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "part",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pinned regular files, Git blob hashes and evidence boundaries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Part"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, hidden, removed or inaccessible part.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Unpinned, unsupported or changed source analysis; inspect manually or retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Source/catalog verification unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying.",
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "429": {
            "description": "Shared installation read allowance reached; respect Retry-After. Default 30 valid requests per fixed minute, configurable with AGENT_READ_LIMIT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying.",
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drafts": {
      "get": {
        "summary": "Read up to 50 drafts created with this credential, unfinished first",
        "security": [
          {
            "DraftCredential": []
          }
        ],
        "responses": {
          "200": {
            "description": "Private drafts; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drafts"
                }
              }
            }
          },
          "400": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Prepare a private proposal for an owned licensed public repository; no paid analysis",
        "description": "source_sha must identify a commit in the selected repository. Owner approval requires its current default branch to match. Same key and canonical proposal return the existing draft with 200; a new proposal returns 201. No automatic retries. Revocation cancels unfinished drafts. A failed GitHub tree lookup returns 503. Body limit 2048 bytes. Per-owner allowance: 30 private requests/minute, 50 new drafts/day and 50 unfinished drafts. Authentication and scope checks precede upstream reads.",
        "security": [
          {
            "DraftCredential": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["repo_id", "source_sha", "note"],
                "properties": {
                  "repo_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "source_sha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 280
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private proposal; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "201": {
            "description": "Private proposal; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "400": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Structured error; retry-after on 429 and 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Search": {
        "type": "object",
        "properties": {
          "format": {
            "const": "repo-salvage/search-v1"
          },
          "catalog_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "query": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "sort": {
                "type": "string"
              }
            },
            "required": ["q", "language", "license", "category", "sort"],
            "additionalProperties": false
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "next": {
                "type": ["string", "null"]
              }
            },
            "required": ["page", "limit", "total", "next"],
            "additionalProperties": false
          },
          "facets": {
            "type": "object",
            "properties": {
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "licenses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "Authentication",
                    "Data processing",
                    "API & networking",
                    "UI & interaction",
                    "Developer tools",
                    "Storage",
                    "Other"
                  ]
                }
              }
            },
            "required": ["languages", "licenses", "categories"],
            "additionalProperties": false
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "listing_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "part_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{16}$"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Authentication",
                    "Data processing",
                    "API & networking",
                    "UI & interaction",
                    "Developer tools",
                    "Storage",
                    "Other"
                  ]
                },
                "repository": {
                  "type": "string"
                },
                "source_commit": {
                  "type": ["string", "null"],
                  "pattern": "^[a-f0-9]{40}$"
                },
                "primary_path": {
                  "type": "string"
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "repository_license": {
                  "type": ["string", "null"]
                },
                "observed_dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "primary_file_coverage": {
                      "type": "string",
                      "enum": [
                        "complete",
                        "prefix",
                        "tree_only",
                        "sampled_extent_unknown",
                        "not_recorded"
                      ]
                    },
                    "declaration_coverage": {
                      "const": "not_verified"
                    },
                    "component_license_status": {
                      "const": "not_audited"
                    },
                    "dependency_graph": {
                      "const": "not_audited"
                    },
                    "owner_reviewed_at": {
                      "type": ["string", "null"]
                    },
                    "independently_tested": {
                      "const": false
                    }
                  },
                  "required": [
                    "primary_file_coverage",
                    "declaration_coverage",
                    "component_license_status",
                    "dependency_graph",
                    "owner_reviewed_at",
                    "independently_tested"
                  ],
                  "additionalProperties": false
                },
                "links": {
                  "type": "object",
                  "properties": {
                    "inspect": {
                      "type": "string"
                    },
                    "page": {
                      "type": "string"
                    }
                  },
                  "required": ["inspect", "page"],
                  "additionalProperties": false
                }
              },
              "required": [
                "listing_id",
                "part_id",
                "name",
                "description",
                "category",
                "repository",
                "source_commit",
                "primary_path",
                "languages",
                "repository_license",
                "observed_dependencies",
                "evidence",
                "links"
              ],
              "additionalProperties": false
            },
            "maxItems": 50
          }
        },
        "required": [
          "format",
          "catalog_revision",
          "query",
          "pagination",
          "facets",
          "results"
        ],
        "additionalProperties": false
      },
      "Part": {
        "type": "object",
        "properties": {
          "format": {
            "const": "repo-salvage/part-v1"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Authentication",
              "Data processing",
              "API & networking",
              "UI & interaction",
              "Developer tools",
              "Storage",
              "Other"
            ]
          },
          "repository": {
            "type": "string"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_url": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["primary", "supporting", "test", "notice"]
                  },
                  "minItems": 1
                },
                "analysis_coverage": {
                  "type": "string",
                  "enum": [
                    "complete",
                    "prefix",
                    "tree_only",
                    "sampled_extent_unknown",
                    "not_recorded"
                  ]
                },
                "git_blob_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "size_bytes": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "download_url": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "roles",
                "analysis_coverage",
                "git_blob_sha",
                "size_bytes",
                "download_url"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "integration_notes": {
            "type": ["string", "null"]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": ["string", "null"]
          },
          "license_notice": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "sampled_source": {
                "type": "boolean"
              },
              "owner_reviewed_at": {
                "type": ["string", "null"]
              },
              "independently_tested": {
                "const": false
              },
              "test_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "analyzed_at": {
                "type": ["string", "null"]
              },
              "model": {
                "type": ["string", "null"]
              },
              "declaration_coverage": {
                "const": "not_verified"
              }
            },
            "required": [
              "sampled_source",
              "owner_reviewed_at",
              "independently_tested",
              "test_files",
              "analyzed_at",
              "model",
              "declaration_coverage"
            ],
            "additionalProperties": false
          },
          "listing_id": {
            "type": "integer",
            "minimum": 1
          },
          "part_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "repository_id": {
                "type": "integer",
                "minimum": 1
              },
              "owner_id": {
                "type": "integer",
                "minimum": 1
              },
              "repository": {
                "type": "string"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "required": ["repository_id", "owner_id", "repository", "commit"],
            "additionalProperties": false
          },
          "dependency_evidence": {
            "type": "object",
            "properties": {
              "status": {
                "const": "not_audited"
              },
              "empty_list_means": {
                "const": "none_identified"
              },
              "local_imports_complete": {
                "const": false
              }
            },
            "required": [
              "status",
              "empty_list_means",
              "local_imports_complete"
            ],
            "additionalProperties": false
          },
          "licensing": {
            "type": "object",
            "properties": {
              "repository_license": {
                "type": ["string", "null"]
              },
              "component_license_status": {
                "const": "not_audited"
              },
              "notice_discovery": {
                "const": "filename_heuristic"
              },
              "notice_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "third_party_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requires_manual_review": {
                "const": true
              }
            },
            "required": [
              "repository_license",
              "component_license_status",
              "notice_discovery",
              "notice_paths",
              "third_party_paths",
              "requires_manual_review"
            ],
            "additionalProperties": false
          },
          "handling": {
            "type": "string"
          }
        },
        "required": [
          "format",
          "name",
          "description",
          "category",
          "repository",
          "source_commit",
          "source_url",
          "files",
          "dependencies",
          "integration_notes",
          "limitations",
          "license",
          "license_notice",
          "evidence",
          "listing_id",
          "part_id",
          "source",
          "dependency_evidence",
          "licensing",
          "handling"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "id",
          "repo_id",
          "full_name",
          "source_sha",
          "note",
          "status",
          "created_at",
          "listing_id",
          "owner_review_required",
          "analysis_charged_on_creation"
        ],
        "properties": {
          "format": {
            "const": "repo-salvage/draft-v1"
          },
