# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Canonical origin also configures trusted-host handling. Use your HTTPS origin in production.
AUTH_URL=http://localhost:3000
# GitHub OAuth app: https://github.com/settings/developers
# Callback URL (local): http://localhost:3000/api/auth/callback/github
# Match AUTH_URL exactly; keep token expiry on, wildcard redirects and device flow off.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Required for a personal/service-account key with access to multiple workspaces.
# Find the wrkspc_ ID in Claude Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=
# Optional overrides
# SUMMARY_MODEL=claude-haiku-5-5
# DATABASE_PATH=./data/salvage.db
# DAILY_SUMMARY_LIMIT=10
# GLOBAL_DAILY_SUMMARY_LIMIT=100
# Numeric GitHub user IDs allowed to review reports at /moderation (no moderators by default).
# MODERATOR_GITHUB_IDS=
